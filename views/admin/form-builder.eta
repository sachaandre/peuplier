<% layout("../layout.eta") %>
<header class="admin-bar">
  <a href="/admin">← Tableau de bord</a>
</header>

<h1>Constructeur de formulaire</h1>
<p class="hint">Ces champs composent le formulaire public, dans l'ordre affiché.</p>

<section>
  <h2>Champs actuels</h2>
  <p class="hint">Glissez-déposez pour réordonner. <span id="order-status"></span></p>
  <ul id="field-list" class="field-list">
    <% it.fields.forEach(function (f) { %>
      <li class="field-row" draggable="true" data-id="<%= f.id %>">
        <span class="handle" aria-hidden="true">⠿</span>
        <div class="field-main">
          <strong><%= f.label %></strong>
          <span class="badge"><%= f.fieldTypeLabel %></span>
          <% if (f.required) { %><span class="badge badge-req">obligatoire</span><% } %>
          <% if (f.private) { %><span class="badge badge-private">privé</span><% } %>
          <% if (f.osunyMapping) { %><span class="badge">Osuny : <%= f.osunyMapping %></span><% } %>
          <% if (f.hasOptions && f.options.length) { %><span class="opts"><%= f.options.join(' · ') %></span><% } %>
        </div>
        <div class="field-tools">
          <a href="/admin/formulaire/<%= f.id %>/editer">Éditer</a>
          <% if (!f.protected) { %>
            <form method="post" action="/admin/formulaire/<%= f.id %>/supprimer" class="inline"
                  onsubmit="return confirm('Supprimer ce champ ? Les réponses déjà reçues ne sont pas effacées mais ne seront plus affichées.');">
              <button type="submit" class="danger-link">Supprimer</button>
            </form>
          <% } else { %>
            <span class="hint">non supprimable</span>
          <% } %>
        </div>
      </li>
    <% }) %>
  </ul>
</section>

<section>
  <h2>Ajouter un champ</h2>
  <form method="post" action="/admin/formulaire" class="builder-form">
    <div class="field">
      <label for="label">Libellé</label>
      <input type="text" id="label" name="label" required>
    </div>
    <div class="field">
      <label for="field_type">Type</label>
      <select id="field_type" name="field_type">
        <% it.types.forEach(function (t) { %>
          <option value="<%= t.value %>"><%= t.label %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="options">Options (une par ligne, pour choix unique/multiple)</label>
      <textarea id="options" name="options" rows="3"></textarea>
    </div>
    <div class="field">
      <label for="osuny_block_mapping">Publication Osuny</label>
      <select id="osuny_block_mapping" name="osuny_block_mapping">
        <option value="">Ne pas publier ce champ</option>
        <% it.mappings.forEach(function (m) { %>
          <option value="<%= m %>"><%= m === 'chapter' ? 'Bloc chapitre' : 'Tableau de métadonnées' %></option>
        <% }) %>
      </select>
    </div>
    <div class="field checkbox-row">
      <label><input type="checkbox" name="required"> Champ obligatoire</label>
      <label><input type="checkbox" name="private"> Champ privé (admin uniquement)</label>
    </div>
    <button type="submit">Ajouter le champ</button>
  </form>
</section>

<script src="/public/form-builder.js" defer></script>